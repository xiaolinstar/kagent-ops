# DeepSeek API Key Secret 模板
# 
# 使用说明：
# 1. 复制此文件为 deepseek-secret.yaml（去掉 .template 后缀）
# 2. 将 YOUR_DEEPSEEK_API_KEY 替换为你的实际 API Key
# 3. 执行: kubectl apply -f deepseek-secret.yaml --context kind-kagent
#
# 获取 API Key：
# - 访问 https://platform.deepseek.com/
# - 登录后在 API Keys 页面创建
#
# 注意：
# - deepseek-secret.yaml 包含敏感信息，不要提交到 Git 仓库
# - 此模板文件可以安全提交

apiVersion: v1
kind: Secret
metadata:
  name: kagent-deepseek
  namespace: kagent
type: Opaque
stringData:
  DEEPSEEK_API_KEY: "YOUR_DEEPSEEK_API_KEY"  # ← 替换为你的实际 API Key
